generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Program {
  field_of_study String? @db.Char
  degree_level   String? @db.Char
  short_codes    String? @db.Char

  @@map("programs")
  @@ignore
}

model Term {
  start_date    DateTime @id @db.Date
  end_date      DateTime @db.Date
  academic_year DateTime @db.Date
  term_id       String   @db.Uuid
  term_name     String   @db.Char
  session_type  String   @db.Char

  @@map("terms")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Application {
  application_id  String?   @db.Uuid
  program_id      String?   @db.Uuid
  submission_date DateTime? @db.Date
  user_id         String?   @db.Uuid

  @@map("applications")
  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Decision {
  pending    String? @db.Char
  accepted   String? @db.Char
  rejected   String? @db.Char
  waitlisted String? @db.Char

  @@map("decisions")
  @@ignore
}

model user {
  email    String? @db.Char
  password String? @db.Char
  id       String  @id(map: "users_pkey") @db.Uuid
}
